<?xml version="1.0" encoding="utf-8"?>
<!-- Shared remote-volume slider for Cast and Switch output. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_cast_volume_overlay"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top|center_horizontal"
    android:layout_marginHorizontal="8dp"
    android:background="@drawable/bg_mobile_cast_volume"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="24dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/remote_volume_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="@string/mobile_cast_tv_volume_label"
        android:src="@drawable/ic_mobile_cast"
        android:tint="@color/mobile_player_on_video" />

    <SeekBar
        android:id="@+id/cast_volume_slider"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:max="100"
        android:progressBackgroundTint="@color/mobile_color_progress_track"
        android:progressTint="@color/mobile_color_progress"
        android:thumbTint="@color/mobile_color_progress" />

    <TextView
        android:id="@+id/cast_volume_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:minWidth="60dp"
        android:textColor="@color/mobile_player_on_video"
        android:textSize="21sp"
        tools:text="45%" />

</LinearLayout>
