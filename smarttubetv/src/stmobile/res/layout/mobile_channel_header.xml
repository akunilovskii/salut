<?xml version="1.0" encoding="utf-8"?>
<com.newtube.mobile.ui.channel.ChannelHeaderLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mobile_channel_header" android:layout_width="match_parent" android:layout_height="wrap_content"
    app:layout_scrollFlags="scroll">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="12dp">
        <ImageView android:id="@+id/channel_header_banner" android:layout_width="match_parent" android:layout_height="104dp"
            android:layout_marginBottom="8dp" android:scaleType="centerCrop" android:importantForAccessibility="no" android:visibility="gone" />
        <LinearLayout android:id="@+id/channel_header_identity" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:id="@+id/channel_header_avatar" android:layout_width="72dp" android:layout_height="72dp"
                android:layout_marginEnd="16dp" android:src="@drawable/ic_watch_channel_placeholder" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <LinearLayout android:id="@+id/channel_header_name_row" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginEnd="40dp" android:gravity="center_vertical">
                    <TextView android:id="@+id/channel_header_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="22sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"
                        android:textColor="@color/mobile_color_on_surface" />
                    <ImageView android:id="@+id/channel_header_verified" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginStart="8dp"
                        android:src="@drawable/ic_channel_verified" android:contentDescription="@string/mobile_channel_verified"
                        android:visibility="gone" android:tint="@color/mobile_color_on_surface" />
                </LinearLayout>
                <TextView android:id="@+id/channel_header_handle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:layout_marginEnd="76dp" android:maxLines="1" android:ellipsize="end"
                    android:textSize="14sp" android:textColor="@color/mobile_color_on_surface" android:visibility="gone" />
                <TextView android:id="@+id/channel_header_counts" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:layout_marginEnd="76dp" android:maxLines="1" android:ellipsize="end"
                    android:textSize="12sp" android:textColor="@color/mobile_color_on_surface_secondary" android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/channel_header_description" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:maxLines="2" android:ellipsize="end"
            android:textSize="14sp" android:textColor="@color/mobile_color_on_surface_secondary" android:background="?attr/selectableItemBackground"
            android:clickable="true" android:focusable="true" android:visibility="gone" />
        <TextView android:id="@+id/channel_header_links" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:minHeight="24dp" android:gravity="center_vertical" android:textSize="12sp"
            android:drawableStart="@drawable/ic_channel_link" android:drawablePadding="4dp" android:maxLines="1" android:ellipsize="middle"
            android:textColor="@color/mobile_color_on_surface" android:background="?attr/selectableItemBackground"
            android:clickable="true" android:focusable="true" android:visibility="gone" />
    </LinearLayout>
    <!-- Full touch targets overlay the card without changing its text geometry. -->
    <LinearLayout android:id="@+id/channel_header_actions" android:layout_width="40dp" android:layout_height="48dp"
        android:layout_gravity="top|end" android:layout_marginEnd="16dp" android:gravity="center">
        <ImageView android:id="@+id/channel_header_more" android:layout_width="@dimen/mobile_icon_action_width" android:layout_height="48dp" android:paddingHorizontal="8dp" android:paddingVertical="12dp"
            android:src="@drawable/ic_menu_more" android:background="@drawable/bg_toolbar_touch" android:tint="@color/mobile_color_on_surface"
            android:contentDescription="@string/mobile_menu_more" android:clickable="true" android:focusable="true" />
    </LinearLayout>
        <FrameLayout android:id="@+id/channel_header_subscription" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="68dp"
            android:layout_gravity="top|end" android:layout_marginEnd="16dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/mobile_watch_subscribe"
                android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/mobile_watch_subscribe" android:visibility="gone"
                android:textAllCaps="false" android:textSize="14sp" android:letterSpacing="0" android:insetTop="4dp" android:insetBottom="4dp" android:insetLeft="0dp" android:insetRight="0dp" android:minWidth="0dp" android:paddingHorizontal="12dp"
                android:backgroundTint="@color/mobile_color_inverse_surface" android:textColor="@color/mobile_color_on_inverse_surface" app:cornerRadius="20dp" />
            <LinearLayout android:id="@+id/mobile_watch_notifications" android:layout_width="68dp" android:layout_height="48dp"
                android:contentDescription="@string/header_notifications"
                android:background="@drawable/bg_channel_notifications" android:gravity="center" android:orientation="horizontal" android:paddingHorizontal="12dp"
                android:clickable="true" android:focusable="true" android:visibility="gone">
                <ImageView android:id="@+id/mobile_watch_notification_icon" android:layout_width="24dp" android:layout_height="24dp"
                    android:src="@drawable/ic_watch_bell" android:importantForAccessibility="no" />
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:src="@drawable/ic_watch_expand" android:importantForAccessibility="no" />
            </LinearLayout>
        </FrameLayout>
</com.newtube.mobile.ui.channel.ChannelHeaderLayout>
