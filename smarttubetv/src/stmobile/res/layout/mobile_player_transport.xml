<?xml version="1.0" encoding="utf-8"?>
<!-- Separate visual buttons and touch containers retain exact sizes at fractional densities. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mobile_player_transport"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <FrameLayout
        android:id="@+id/mobile_player_previous_touch_area"
        android:layout_width="@dimen/mobile_player_icon_button"
        android:layout_height="@dimen/mobile_player_icon_button"
        android:layout_marginEnd="24dp">
        <ImageButton
            android:id="@+id/mobile_player_previous"
            android:layout_width="@dimen/mobile_player_transport_side_button"
            android:layout_height="@dimen/mobile_player_transport_side_button"
            android:layout_gravity="center"
            android:background="@drawable/mobile_player_center_button_bg"
            android:contentDescription="@string/mobile_player_previous"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_previous" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/mobile_player_center_touch_area"
        android:layout_width="@dimen/mobile_player_center_touch_target"
        android:layout_height="@dimen/mobile_player_center_touch_target">
        <ImageButton
            android:id="@+id/mobile_player_play_pause"
            android:layout_width="@dimen/mobile_player_center_button"
            android:layout_height="@dimen/mobile_player_center_button"
            android:layout_gravity="center"
            android:background="@drawable/mobile_player_center_button_bg"
            android:contentDescription="@string/mobile_player_pause"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_transport_pause" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/mobile_player_next_touch_area"
        android:layout_width="@dimen/mobile_player_icon_button"
        android:layout_height="@dimen/mobile_player_icon_button"
        android:layout_marginStart="24dp">
        <ImageButton
            android:id="@+id/mobile_player_next"
            android:layout_width="@dimen/mobile_player_transport_side_button"
            android:layout_height="@dimen/mobile_player_transport_side_button"
            android:layout_gravity="center"
            android:background="@drawable/mobile_player_center_button_bg"
            android:contentDescription="@string/mobile_player_next"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_next" />
    </FrameLayout>
</LinearLayout>
